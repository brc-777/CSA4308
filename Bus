<!DOCTYPE html>
<html>
<head>
    <title>Bus Ticket Booking</title>
</head>

<body>

<h1>Bus Ticket Booking System</h1>

<!-- Login -->
<h2>Login</h2>

<input type="text" id="user" placeholder="Username">
<input type="password" id="pass" placeholder="Password">

<button onclick="login()">Login</button>

<p id="loginResult"></p>

<hr>

<!-- Bus Details -->
<h2>Available Buses</h2>

<table border="1">
    <tr>
        <th>Bus</th>
        <th>Route</th>
        <th>Time</th>
        <th>Seats</th>
        <th>Action</th>
    </tr>

    <tr>
        <td>Volvo</td>
        <td>Chennai - Bangalore</td>
        <td>8:00 AM</td>
        <td id="bus1">10</td>
        <td>
            <button onclick="selectBus('bus1')">Book</button>
        </td>
    </tr>

    <tr>
        <td>Express</td>
        <td>Chennai - Hyderabad</td>
        <td>9:00 AM</td>
        <td id="bus2">8</td>
        <td>
            <button onclick="selectBus('bus2')">Book</button>
        </td>
    </tr>

    <tr>
        <td>Super Fast</td>
        <td>Chennai - Coimbatore</td>
        <td>10:00 AM</td>
        <td id="bus3">12</td>
        <td>
            <button onclick="selectBus('bus3')">Book</button>
        </td>
    </tr>
</table>

<hr>

<!-- Booking -->
<h2>Book Ticket</h2>

<input type="text" id="name" placeholder="Passenger Name">

<input type="date" id="date">

<button onclick="bookTicket()">Confirm Booking</button>

<p id="bookingResult"></p>

<hr>

<!-- Cancel -->
<h2>Cancel Ticket</h2>

<button onclick="cancelTicket()">Cancel Ticket</button>

<hr>

<!-- Comments -->
<h2>Comments</h2>

<input type="text" id="comment" placeholder="Enter your comment">

<button onclick="addComment()">Submit</button>

<p id="commentResult"></p>


<script>

let selectedBus = "";
let bookedBus = "";

// Login
function login() {

    let user = document.getElementById("user").value;
    let pass = document.getElementById("pass").value;

    if (user == "user" && pass == "1234") {

        document.getElementById("loginResult").innerHTML =
        "Login Successful";

    }
    else {

        document.getElementById("loginResult").innerHTML =
        "Invalid Login";

    }
}


// Select bus
function selectBus(bus) {

    selectedBus = bus;

    alert("Bus selected");

}


// Book ticket
function bookTicket() {

    let name = document.getElementById("name").value;
    let date = document.getElementById("date").value;

    if (name == "" || date == "" || selectedBus == "") {

        alert("Please enter all details");

        return;
    }

    let seats = document.getElementById(selectedBus);

    if (seats.innerHTML > 0) {

        seats.innerHTML--;

        bookedBus = selectedBus;

        document.getElementById("bookingResult").innerHTML =
        "Ticket booked successfully for " + name;

    }
    else {

        alert("No seats available");

    }
}


// Cancel ticket
function cancelTicket() {

    if (bookedBus == "") {

        alert("No booking found");

        return;
    }

    let seats = document.getElementById(bookedBus);

    seats.innerHTML++;

    document.getElementById("bookingResult").innerHTML =
    "Ticket cancelled successfully";

    bookedBus = "";

}


// Comments
function addComment() {

    let comment =
    document.getElementById("comment").value;

    document.getElementById("commentResult").innerHTML =
    "Your comment: " + comment;

}

</script>

</body>
</html>
