<!DOCTYPE html>
<html>
<head>
    <title>Flight Reservation</title>
</head>

<body>

<h1>Flight Reservation System</h1>

<!-- Login -->
<h2>Login</h2>

<input type="text" id="user" placeholder="Username">
<input type="password" id="pass" placeholder="Password">
<button onclick="login()">Login</button>

<p id="loginResult"></p>

<hr>

<!-- Search Flight -->
<h2>Search Flight</h2>

<input type="text" id="from" placeholder="From">
<input type="text" id="to" placeholder="To">

<button onclick="searchFlight()">Search</button>

<p id="flightResult"></p>

<hr>

<!-- Book Ticket -->
<h2>Book Ticket</h2>

<input type="text" id="name" placeholder="Passenger Name">

<button onclick="bookTicket()">Book Ticket</button>

<p id="bookingResult"></p>

<hr>

<!-- Booking Status -->
<h2>Booking Status</h2>

<button onclick="checkStatus()">Check Status</button>

<p id="status"></p>

<hr>

<!-- Cancel -->
<h2>Cancel Ticket</h2>

<button onclick="cancelTicket()">Cancel Ticket</button>

<p id="cancelResult"></p>

<hr>

<!-- Feedback -->
<h2>Customer Feedback</h2>

<input type="text" id="feedback" placeholder="Enter feedback">

<button onclick="sendFeedback()">Submit</button>

<p id="feedbackResult"></p>


<script>

let flightFound = false;
let booked = false;


// Login
function login() {

    let user = document.getElementById("user").value;
    let pass = document.getElementById("pass").value;

    if (user == "user" && pass == "1234") {
        document.getElementById("loginResult").innerHTML =
        "Login Successful";
    }
    else {
        document.getElementById("loginResult").innerHTML =
        "Invalid Login";
    }
}


// Search Flight
function searchFlight() {

    let from = document.getElementById("from").value;
    let to = document.getElementById("to").value;

    if (from == "" || to == "") {
        alert("Enter From and To");
        return;
    }

    flightFound = true;

    document.getElementById("flightResult").innerHTML =
    "Flight available: " + from + " to " + to;
}


// Book Ticket
function bookTicket() {

    let name = document.getElementById("name").value;

    if (name == "" || flightFound == false) {
        alert("Search flight and enter name");
        return;
    }

    booked = true;

    document.getElementById("bookingResult").innerHTML =
    "Ticket booked successfully for " + name;
}


// Check Status
function checkStatus() {

    if (booked == true) {
        document.getElementById("status").innerHTML =
        "Booking Status: CONFIRMED";
    }
    else {
        document.getElementById("status").innerHTML =
        "No booking found";
    }
}


// Cancel Ticket
function cancelTicket() {

    if (booked == true) {

        booked = false;

        document.getElementById("cancelResult").innerHTML =
        "Ticket cancelled successfully";

    }
    else {
        alert("No ticket found");
    }
}


// Feedback
function sendFeedback() {

    let feedback =
    document.getElementById("feedback").value;

    document.getElementById("feedbackResult").innerHTML =
    "Thank you for your feedback!";
}

</script>

</body>
</html>
