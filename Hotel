<!DOCTYPE html>
<html>
<head>
    <title>Hotel Booking</title>
</head>

<body>

<h1>Hotel Room Booking System</h1>

<!-- Login -->
<h2>Login</h2>

<input type="text" id="user" placeholder="Username">
<input type="password" id="pass" placeholder="Password">
<button onclick="login()">Login</button>

<p id="loginResult"></p>

<hr>

<!-- Rooms -->
<h2>Hotel Rooms</h2>

<table border="1">
    <tr>
        <th>Room</th>
        <th>Price</th>
        <th>Available</th>
        <th>Action</th>
    </tr>

    <tr>
        <td>Single</td>
        <td>₹1000</td>
        <td id="single">5</td>
        <td>
            <button onclick="book('single')">Book</button>
        </td>
    </tr>

    <tr>
        <td>Double</td>
        <td>₹2000</td>
        <td id="double">3</td>
        <td>
            <button onclick="book('double')">Book</button>
        </td>
    </tr>

    <tr>
        <td>Deluxe</td>
        <td>₹3000</td>
        <td id="deluxe">2</td>
        <td>
            <button onclick="book('deluxe')">Book</button>
        </td>
    </tr>
</table>

<hr>

<!-- Booking -->
<h2>Booking Details</h2>

<input type="text" id="name" placeholder="Guest Name">
<input type="date" id="date">

<button onclick="confirmBooking()">Confirm Booking</button>

<p id="result"></p>

<hr>

<!-- Cancel -->
<h2>Cancel Booking</h2>

<button onclick="cancelBooking()">Cancel Last Booking</button>

<script>

let selectedRoom = "";
let lastBooking = "";

// Login
function login() {

    let user = document.getElementById("user").value;
    let pass = document.getElementById("pass").value;

    if (user == "user" && pass == "1234") {
        document.getElementById("loginResult").innerHTML =
        "Login Successful";
    }
    else {
        document.getElementById("loginResult").innerHTML =
        "Invalid Login";
    }
}


// Select room
function book(room) {

    selectedRoom = room;

    alert("Room selected");
}


// Confirm booking
function confirmBooking() {

    let name = document.getElementById("name").value;
    let date = document.getElementById("date").value;

    if (name == "" || date == "" || selectedRoom == "") {
        alert("Please enter all details");
        return;
    }

    let room = document.getElementById(selectedRoom);

    if (room.innerHTML > 0) {

        room.innerHTML--;

        lastBooking = selectedRoom;

        document.getElementById("result").innerHTML =
        "Room booked successfully for " + name +
        " on " + date;

    }
    else {
        alert("Room not available");
    }
}


// Cancel booking
function cancelBooking() {

    if (lastBooking == "") {
        alert("No booking found");
        return;
    }

    let room = document.getElementById(lastBooking);

    room.innerHTML++;

    document.getElementById("result").innerHTML =
    "Booking cancelled";

    lastBooking = "";
}

</script>

</body>
</html>
